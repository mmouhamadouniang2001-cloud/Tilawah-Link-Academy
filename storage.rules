rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Lecture publique des fichiers (images, vidéos, audios)
      allow read: if true;

      // Écriture : utilisateur authentifié + taille max 10 MB
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
